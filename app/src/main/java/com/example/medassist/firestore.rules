rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
//
// Design notes (read this before changing signup/roles):
//
// 1. The app's signup screen has no role picker — every self-service signup writes
//    role: "patient" (see AuthViewModel.kt). But that alone is only a UI convenience, not
//    security: a modified or malicious client could still try to send role: "doctor" directly
//    to Firestore. The `create` rule below is what actually rejects that, independent of what
//    the app does.
//
// 2. Doctor accounts are provisioned by an admin: open the Firebase console, find the user's
//    document under `users/{uid}`, and change `role` to `"doctor"` by hand. There is
//    deliberately no self-service path to become a doctor.
//
// 3. A user can never edit their own role once created (see the `update` rule) — without
//    this, a patient could just edit their own document and set role: "doctor" themselves.
//
// 4. Reading the roster of patients (what DoctorViewModel.kt's `.whereEqualTo("role",
//    "patient")` listener does) is only allowed for callers whose OWN user doc already has
//    role == "doctor" — checked via `get()`, which reads the real stored value, not whatever
//    the caller claims.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // A user can always read their own profile. A doctor can read (and list/query) any
      // user document — this is what lets DoctorViewModel's patient-roster query work, but
      // ONLY for accounts that are already doctors per Firestore's own stored data.
      allow get, list: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor'
      );

      // Self-service account creation is patient-only. There is no way for a client to
      // create their own doctor account, regardless of what the app UI sends.
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == 'patient';

      // A user may update their own profile, but NEVER change their own role.
      // (Admin-driven promotion to "doctor" happens via the Firebase console/admin SDK,
      // which bypasses these rules entirely — that's expected and fine.)
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role;

      allow delete: if false;

      // Per-patient medicines (reminders/prescriptions) and reports live as subcollections
      // under the patient's own user doc. A patient manages their own; a doctor can read/add
      // for any patient (this is how PrescriptionScreen/PatientDetailsScreen add prescriptions
      // and how PatientDashboard reads the logged-in patient's own list).
      match /medicines/{medicineId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor'
        );
      }

      match /reports/{reportId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor'
        );
      }
    }

    // Everything else: locked down by default. Add explicit rules as new collections
    // are introduced instead of leaving them open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
